.privacy-consent-overlay{position:fixed;inset:0;z-index:100;background:#000b;display:flex;align-items:center;justify-content:center;padding:30rpx}.privacy-consent-dialog{width:100%;max-width:620rpx;border-radius:20rpx;background:#202025;padding:32rpx;color:#fff;box-sizing:border-box}.privacy-consent-title{display:block;font-size:32rpx;font-weight:600}.privacy-consent-copy{display:block;font-size:24rpx;line-height:1.8;margin-top:20rpx;color:#ccc}.privacy-consent-dialog button{font-size:24rpx;line-height:2.8;margin-top:20rpx;background:#f23bd1;color:#fff;border-radius:12rpx}.privacy-consent-dialog .privacy-consent-read,.privacy-consent-dialog .privacy-consent-decline{background:#323238;color:#eac3e7}
