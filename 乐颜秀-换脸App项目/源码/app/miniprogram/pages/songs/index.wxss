.page{background:#000;color:#fff;box-sizing:border-box;min-height:100vh;padding-bottom:40rpx}.header{display:flex;align-items:center;justify-content:space-between;margin:0 28rpx 26rpx}.title{font-size:53rpx;font-weight:700;color:#f23bd1}.header-actions{display:flex;align-items:center;gap:18rpx}.history{font-size:46rpx;line-height:64rpx;padding:0 10rpx}.credits{font-size:23rpx;border-radius:12rpx;background:#19191d;padding:20rpx}.gift{color:#f23bd1}.banner-wrap{position:relative;margin:0 28rpx}.banners{height:304rpx;border:1rpx solid #ffffff20;border-radius:14rpx;overflow:hidden}.banner{position:relative;height:100%;width:100%}.banner image{position:absolute;width:100%;height:100%}.banner-scrim{position:absolute;inset:0;background:linear-gradient(90deg,#000d,#0002 80%)}.banner-content{position:absolute;left:24rpx;top:0;bottom:0;display:flex;flex-direction:column;justify-content:center;width:62%}.kicker{font-size:21rpx;color:#72f5d1}.banner-title{font-size:31rpx;font-weight:600;line-height:1.4;margin-top:11rpx}.banner-action{align-self:flex-start;padding:16rpx 21rpx;background:#f23bd1;border-radius:11rpx;font-size:23rpx;font-weight:600;margin-top:20rpx}.dots{position:absolute;right:20rpx;bottom:15rpx;display:flex;gap:8rpx}.dot{width:8rpx;height:8rpx;background:#ffffff66;border-radius:8rpx}.dot.selected{width:26rpx;background:#fff}.categories{margin-top:22rpx;white-space:nowrap;box-sizing:border-box;width:100%}.category-row{display:inline-flex;padding:0 28rpx;gap:31rpx}.category{font-size:25rpx;color:#85858a;padding:20rpx 0 22rpx;position:relative}.category.active{color:#fff}.category.active::after{content:"";position:absolute;bottom:0;left:0;right:0;height:4rpx;background:#72f5d1;border-radius:4rpx}.grid{display:flex;flex-wrap:wrap;justify-content:space-between;padding:26rpx 28rpx 0;gap:28rpx 0}.card{width:calc(50% - 9rpx)}.cover-wrap{position:relative;width:100%;height:444rpx;overflow:hidden;border-radius:13rpx;background:#19191d}.cover{width:100%;height:100%}.card-scrim{position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,#0008)}.new{position:absolute;top:17rpx;left:17rpx;border-radius:30rpx;background:#f23bd1;padding:6rpx 12rpx;font-size:18rpx}.play{position:absolute;top:16rpx;right:16rpx;background:#0008;width:43rpx;height:43rpx;line-height:43rpx;text-align:center;border-radius:50%;font-size:20rpx}.card-action{position:absolute;left:16rpx;bottom:18rpx;background:#f23bd1;padding:17rpx 20rpx;border-radius:11rpx;font-size:23rpx;font-weight:600}.preview-label{position:absolute;right:13rpx;bottom:27rpx;font-size:18rpx;color:#fff9}.name{display:block;font-size:27rpx;margin-top:13rpx;line-height:1.5}.empty{margin:28rpx;padding:80rpx 30rpx;border:1rpx dashed #ffffff26;border-radius:14rpx;text-align:center;color:#929295}
.banner-note{font-size:19rpx;color:#fff9;margin-top:11rpx}.preview-label{left:16rpx;right:auto;bottom:100rpx;font-size:17rpx}
