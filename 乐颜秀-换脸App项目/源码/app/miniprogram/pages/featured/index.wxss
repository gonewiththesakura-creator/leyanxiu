page{overflow:hidden}.feed{height:100vh;background:#000}.slide{position:relative;height:100%;overflow:hidden}.poster,.preview{position:absolute;inset:0;width:100%;height:100%}.scrim{position:absolute;inset:0;background:linear-gradient(180deg,#0002 0%,transparent 42%,#0003 66%,#000e 100%);pointer-events:none}.top-row{position:absolute;left:28rpx;right:28rpx;display:flex;justify-content:space-between;align-items:center}.demo-tag{background:#0007;color:#fff;padding:9rpx 17rpx;font-size:20rpx;border-radius:30rpx}.sound{height:65rpx;width:65rpx;border-radius:50%;background:#0008;line-height:65rpx;text-align:center;font-size:35rpx;color:#fff}.bottom{position:absolute;left:28rpx;right:28rpx;bottom:28rpx;display:flex;flex-direction:column;color:#fff}.category{font-size:23rpx;color:#ffffffc0}.title{font-size:49rpx;font-weight:700;line-height:1.25;margin-top:12rpx}.description{font-size:25rpx;color:#ffffffcc;line-height:1.5;margin-top:12rpx;max-width:90%}.error{font-size:23rpx;color:#ffd6ef;margin-top:12rpx}.cta{display:flex;align-items:center;justify-content:center;min-height:85rpx;margin-top:31rpx;border-radius:12rpx;background:#f23bd1;font-size:27rpx;font-weight:600;box-shadow:0 12rpx 36rpx #f23bd133}.swipe-tip{font-size:20rpx;text-align:center;color:#ffffff88;margin-top:17rpx}
