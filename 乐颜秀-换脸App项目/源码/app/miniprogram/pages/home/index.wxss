.page{min-height:100vh;box-sizing:border-box;background:#000;color:#fff;padding-bottom:40rpx}.header{padding:0 30rpx 26rpx}.title{font-size:56rpx;font-weight:700;color:#f23bd1}.categories{display:flex;margin:0 30rpx;border-bottom:1rpx solid #ffffff14}.category{position:relative;flex:1;text-align:center;font-size:27rpx;color:#8e8e92;padding:24rpx 0}.category.active{color:#fff}.category.active::after{content:"";position:absolute;bottom:0;width:52rpx;height:5rpx;border-radius:4rpx;left:calc(50% - 26rpx);background:#72f5d1}.section-heading{display:flex;flex-direction:column;margin:36rpx 30rpx 26rpx}.kicker{font-size:24rpx;color:#72f5d1}.section-title{font-size:40rpx;font-weight:600;margin-top:9rpx}.list{padding:0 30rpx}.rank-card{display:flex;gap:22rpx;background:#19191d;border:1rpx solid #ffffff14;border-radius:14rpx;padding:22rpx;margin-bottom:22rpx;min-height:228rpx;box-sizing:border-box}.cover-wrap{position:relative;width:174rpx;min-height:228rpx;flex-shrink:0;overflow:hidden;border-radius:13rpx}.cover{width:100%;height:100%;position:absolute}.rank-label{position:absolute;top:12rpx;left:12rpx;background:#0009;padding:6rpx 12rpx;border-radius:24rpx;font-size:19rpx}.content{display:flex;flex:1;min-width:0;flex-direction:column}.name{font-size:34rpx;font-weight:600;margin-top:6rpx}.details{font-size:25rpx;color:#909094;margin-top:14rpx}.action-row{display:flex;justify-content:flex-end;margin-top:auto;padding-top:20rpx}.action{background:#f23bd1;border-radius:12rpx;padding:19rpx 22rpx;font-size:24rpx;font-weight:600}.empty{padding:80rpx 20rpx;text-align:center;color:#929295;border:1rpx dashed #ffffff30;border-radius:14rpx}
