# Merge into secret configuration only after review. No real charges by default.
XPAY_ENABLED=false
XPAY_MODE=closed
XPAY_ENV=1
XPAY_DB_BACKEND=sqlite
XPAY_SQLITE_FILE=
# All MySQL connections require a trusted CA, TLS 1.2+ and certificate identity verification.
# Use the provider-approved host matching the certificate. Never disable verification.
XPAY_MYSQL_HOST=
XPAY_MYSQL_PORT=3306
XPAY_MYSQL_USER=
XPAY_MYSQL_PASSWORD=
XPAY_MYSQL_DATABASE=
XPAY_MYSQL_CA_FILE=
XPAY_SESSION_ENCRYPTION_KEY=
XPAY_OFFER_ID=
XPAY_SANDBOX_APP_KEY=
XPAY_APP_KEY=
XPAY_MESSAGE_TOKEN=
XPAY_MESSAGE_AES_KEY=
# JSON + safe mode; URL /api/mini/payments/notify
XPAY_TEST_USER_IDS=
XPAY_PRODUCTS_JSON=[]
# Exact purpose names only. Video template duration/cost must be approved separately before activation.
XPAY_PURPOSE_RULES_JSON={}
XPAY_ACCEPTANCE_FILE=
XPAY_ACCEPTANCE_SHA256=
XPAY_RECONCILE_ENABLED=false
