# Copy to /etc/leyanxiu/server.env on the ECS host and chmod 600.
# This is a controlled APK test environment, not a public-production approval.
DEPLOY_ENV=staging
RELEASE_CHANNEL=android-app
APP_PACKAGE_NAME=com.yibohuaxia.leyanxiu
APP_RECORD_NO=
ICP_RECORD_NO=
AUTH_MODE=anonymous
AUTH_SESSION_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
AUTH_SESSION_TTL_SECONDS=86400
ADMIN_SESSION_SECRET=GENERATE_A_SEPARATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ADMIN_COOKIE_SECURE=true
# Use `npm run admin:hash-password -- '<password>'`; never put a plaintext admin password here.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=受控测试管理员
ADMIN_PASSWORD_HASH=
ADMIN_REQUIRE_DUAL_APPROVAL=true
CLOSED_TEST_MODE=true
CLOSED_TEST_CREDITS=12
CLOSED_TEST_DAILY_GENERATION_LIMIT=20

# Temporary debug APK endpoint. Do not send real faces or other personal data
# over this cleartext endpoint. Replace with the filed HTTPS API domain next.
PUBLIC_BASE_URL=http://REDACTED_COMPANY_INFRASTRUCTURE
# Capacitor Android WebView origin. Add only exact reviewed web origins.
CORS_ORIGIN=https://localhost

# Start with mock for network/UI verification. Switch only after provider keys
# and real capability evidence have been installed outside the repository.
PROVIDER=mock
PHOTO_PROVIDER=viapi
LLM_PROVIDER=deepseek

# A mounted local store is acceptable for controlled testing on one ECS.
# Public production must move objects/tasks to a verified private OSS bucket.
TASKS_BACKEND=file
TASKS_FILE=/var/lib/leyanxiu/data/tasks.json
OBJECT_STORAGE_BACKEND=file
OBJECT_PREFIX=private
OBJECT_SIGNING_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
OBJECT_URL_TTL_SECONDS=900
MAX_OBJECT_BYTES=104857600
MAX_REQUEST_BYTES=20971520
MAX_VIDEO_REQUEST_BYTES=157286400
MAX_VIDEO_BYTES=104857600
INPUT_RETENTION_SECONDS=86400
OUTPUT_RETENTION_SECONDS=86400
RETENTION_SWEEP_MINUTES=60

FACE_CONSENT_VERSION=closed-test-android-v1
BASIC_CONSENT_VERSION=closed-test-android-v1
CONTENT_POLICY_VERSION=closed-test-policy-v1
CONTENT_SAFETY_MODE=local_rules
AI_MARKING_REQUIRED=true
PAYMENT_MODE=closed_test
MONITORING_MODE=local_log
ALERT_P95_MS=15000
INTERNAL_CRON_TOKEN=GENERATE_A_THIRD_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# These paths are mounted writable by deploy/compose.yml. Do not point them at /app.
ADMIN_DATA_DIR=/var/lib/leyanxiu/data
ADMIN_STORE_FILE=/var/lib/leyanxiu/data/admin-console.json
ADMIN_WORKFLOW_DATA_DIR=/var/lib/leyanxiu/data
ADMIN_WORKFLOW_STORE_FILE=/var/lib/leyanxiu/data/admin-workflows.json
CAPABILITY_EVIDENCE_DIR=/var/lib/leyanxiu/reports/capabilities

# Company-approved public documents. Keep empty until approved; the UI reports
# pending_company_approval instead of inventing approval.
PRIVACY_POLICY_URL=
USER_AGREEMENT_URL=
THIRD_PARTY_LIST_URL=
SUPPORT_CONTACT=
PIPIA_REFERENCE=
AI_SERVICE_DISCLOSURES_JSON=[]

# Provider credentials and template identifiers belong only in the host env.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_ENDPOINT=facebody.cn-shanghai.aliyuncs.com
OSS_BUCKET=
OSS_REGION=oss-cn-shanghai
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
REDACTED_SECRET
VOLC_API_KEY=
TPL_JINQU=
TPL_JINQU_URL=
TPL_STREET=
TPL_STREET_URL=
TPL_STREET_MASK=
TPL_DANCE=
TPL_DANCE_URL=
TPL_QUOTE=
TPL_QUOTE_URL=
