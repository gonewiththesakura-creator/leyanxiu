# Install alongside nginx.app-account-http.conf after certificate issuance.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_reject_handshake on;
}
server {
    listen 443 ssl;
    server_name REDACTED_COMPANY_INFRASTRUCTURE;
    ssl_certificate /etc/letsencrypt/live/REDACTED_COMPANY_INFRASTRUCTURE/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REDACTED_COMPANY_INFRASTRUCTURE/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    # Request URLs can contain signed object tokens. Do not put them in access logs.
    access_log off;
    client_max_body_size 20m;
    location ~ ^/(?:api/(?:internal|admin|ops)|admin)(?:/|$) { return 404; }
    location ~ /\. { return 404; }
    location / {
        proxy_pass http://127.0.0.1:3300;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host REDACTED_COMPANY_INFRASTRUCTURE;
        proxy_set_header Forwarded "";
        proxy_read_timeout 60s;
    }
}
