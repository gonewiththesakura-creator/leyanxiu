# Dedicated App account test service; never copy mini-program/cloudbase secrets.
# Install as /etc/leyanxiu-app-account/server.env mode 600; fill secrets on host.
DEPLOY_ENV=staging
RELEASE_CHANNEL=android-app
APP_PACKAGE_NAME=com.yibohuaxia.leyanxiu
AUTH_MODE=device_key
APP_LOGIN_ENABLED=true
BILLING_BACKEND=postgres
BILLING_DATABASE_URL=
COMPLIANCE_BACKEND=sqlite
COMPLIANCE_SQLITE_FILE=/var/lib/leyanxiu-app-account/data/identity.db
TASKS_BACKEND=file
OBJECT_STORAGE_BACKEND=file
ADMIN_SNAPSHOT_BACKEND=file
METRICS_BACKEND=file
METRICS_SNAPSHOT_PATH=/var/lib/leyanxiu-app-account/data/metrics-snapshot.json
AUTH_SESSION_SECRET=
OBJECT_SIGNING_SECRET=
ADMIN_SESSION_SECRET=
REPORT_DATA_ENCRYPTION_KEY=
ACCOUNT_OTP_SECRET=
INTERNAL_CRON_TOKEN=
CLOSED_TEST_MODE=true
CLOSED_TEST_REQUIRE_INVITE=true
CLOSED_TEST_INVITE_SECRET=
CLOSED_TEST_MAX_USERS=20
CLOSED_TEST_CREDITS=0
CLOSED_TEST_DAILY_GENERATION_LIMIT=1
PROVIDER=mock
ALLOW_MOCK_PROVIDER=true
PAYMENT_MODE=closed_test
PAYMENT_RECONCILE_ENABLED=false
PAYMENT_BILL_RECONCILE_ENABLED=false
XPAY_ENABLED=false
XPAY_MODE=closed
WECHAT_LOGIN_APPROVED=false
SMS_PROVIDER=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_DAILY_LIMIT=20
PUBLIC_BASE_URL=
BIND_HOST=127.0.0.1
PORT=3300
CORS_ORIGIN=https://localhost
TRUST_PROXY_HEADERS=false
PRIVACY_POLICY_URL=
USER_AGREEMENT_URL=
ADMIN_COOKIE_SECURE=true
ADMIN_REQUIRE_DUAL_APPROVAL=true
CONTENT_SAFETY_MODE=local_rules
AI_MARKING_REQUIRED=true
