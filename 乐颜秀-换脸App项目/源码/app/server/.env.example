# 渠道选择：aliyun（主）/ tencent（备）/ volcengine（备）/ mock（仅显式本地联调）
# 未配置时保持 unconfigured，避免部署环境静默返回模拟成功。
PROVIDER=unconfigured
ALLOW_MOCK_PROVIDER=false
DEPLOY_ENV=development
# wechat-mini-program / android-app
RELEASE_CHANNEL=wechat-mini-program

# 身份：anonymous 只允许封闭测试；小程序生产用 wechat；Android 生产用 device_key
AUTH_MODE=anonymous
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=86400
AUTH_CHALLENGE_TTL_SECONDS=120
AUTH_CHALLENGE_MAX_ACTIVE=10000
# device_key 只证明设备持有，不能替代深度合成所需实名核验；适配器未完成前生产保持 NO-GO
REAL_NAME_AUTH_MODE=not_configured
REAL_NAME_AUTH_PROVIDER=
REAL_NAME_AUTH_VERIFIED=false
CLOSED_TEST_MODE=true
CLOSED_TEST_CREDITS=12
CLOSED_TEST_DAILY_GENERATION_LIMIT=20
CLOSED_TEST_REQUIRE_INVITE=true
CLOSED_TEST_INVITE_SECRET=
CLOSED_TEST_MAX_USERS=500
WECHAT_APP_ID=
WECHAT_APP_SECRET=
MINIPROGRAM_APPID=
MINIPROGRAM_RECORD_NO=
ICP_RECORD_NO=
APP_PACKAGE_NAME=
APP_RECORD_NO=

# 任务台账：file（默认，单实例）/ oss
# OSS 必须有对应存储权限后再显式开启，避免错误凭据导致启动降级
TASKS_BACKEND=file
TASKS_FILE=
# OSS object key for this service's task ledger; use a unique prefix per CloudBase service
# Example staging value: server/stage/tasks.json
TASKS_OSS_KEY=server/tasks.json

# 私有对象存储：file 仅用于本地/封闭测试；生产必须使用已核验的私有 OSS bucket
OBJECT_STORAGE_BACKEND=file
OSS_BUCKET=
OSS_REGION=oss-cn-shanghai
PRIVATE_OBJECT_DIR=
OBJECT_INDEX_FILE=
# When OBJECT_STORAGE_BACKEND=oss, this private JSON object is the authoritative
# object index. It is suitable only for a closed-test single instance; production
# must migrate the index to a transactional database or object-index service.
OBJECT_INDEX_OSS_KEY=server/private-object-index.json
OBJECT_PREFIX=private
PRIVATE_BUCKET_AUDIT_REPORT=
OBJECT_SIGNING_SECRET=
OBJECT_URL_TTL_SECONDS=300
MAX_OBJECT_BYTES=104857600
MAX_REQUEST_BYTES=20971520
MAX_VIDEO_REQUEST_BYTES=157286400
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_SIDE=8192
MAX_IMAGE_PIXELS=40000000
MAX_VIDEO_BYTES=104857600
INPUT_RETENTION_SECONDS=86400
OUTPUT_RETENTION_SECONDS=86400
RETENTION_SWEEP_MINUTES=60
RETENTION_SUPPLIER_POLICY=
SUPPLIER_DELETION_CAPABILITIES_JSON={}
SUPPLIER_DELETION_WEBHOOK_URL=
SUPPLIER_DELETION_WEBHOOK_SECRET=

# 照片换脸：viapi（精确融合，默认）/ bailian（生成式换脸）
PHOTO_PROVIDER=viapi

# 文本对话：deepseek（默认，如已配置）/ hunyuan
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
REDACTED_SECRET

# 阿里云（主渠道，0.8元/分钟）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_ENDPOINT=facebody.cn-shanghai.aliyuncs.com
ALIYUN_CONNECT_TIMEOUT_MS=10000
ALIYUN_READ_TIMEOUT_MS=60000

# 腾讯云（备用渠道，vclm 视频人脸融合大模型）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
REDACTED_SECRET

# 火山引擎（备用渠道，AI MediaKit face-swap-video）
# 控制台「API Key 管理」创建：https://console.volcengine.com/
VOLC_API_KEY=

# 阿里云百炼（Model Studio；PHOTO_PROVIDER=bailian 时使用）
DASHSCOPE_API_KEY=
REDACTED_SECRET.0-pro
DASHSCOPE_BASE=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
BAILIAN_MODEL=qwen-image-edit-plus

# 已上线模板视频公网 URL
TPL_JINQU_URL=
TPL_STREET_URL=
TPL_DANCE_URL=
TPL_QUOTE_URL=
TPL_STREET_MASK=

# 合规/发布闸门：未填写企业审批值时只显示 CLOSED_TEST/NO-GO，不会伪造通过
FACE_CONSENT_VERSION=unapproved-local-v1
BASIC_CONSENT_VERSION=unapproved-local-v1
FACE_CONSENT_NOTICE_SHA256=
BASIC_CONSENT_NOTICE_SHA256=
CONTENT_POLICY_VERSION=unapproved-local-v1
CONTENT_SAFETY_MODE=local_rules
CONTENT_SAFETY_API_KEY=
REDACTED_SECRET
AI_MARKING_CONFORMANCE_REPORT=
AI_MARKING_CONFORMANCE_REPORT_SHA256=
SERVICE_PROVIDER_CODE=
AI_MODEL_FILING_REFERENCE=
LICENSED_ASSET_IDS=
INTERNAL_CRON_TOKEN=
# 管理后台：生产使用 ADMIN_USERS_JSON 中的具名账号和 scrypt 哈希，禁止明文密码。
# 哈希生成：npm run admin:hash-password -- <至少12位的新密码>
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=14400
ADMIN_COOKIE_SECURE=false
ADMIN_REQUIRE_DUAL_APPROVAL=true
ADMIN_USERS_JSON=[]
# 仅本机临时验收可显式开启，生产环境会忽略；默认关闭以防部署环境标记错误。
ADMIN_ALLOW_INSECURE_LOCAL=false
# 下列两项只便于单账号迁移；ADMIN_PASSWORD 仅在上述本地开关开启时使用。
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=
ADMIN_STORE_FILE=
# 能力/模板接入需求工作流：仅供封闭测试；生产必须迁移到事务数据库后再启用
ADMIN_WORKFLOW_DATA_DIR=
ADMIN_WORKFLOW_STORE_FILE=
MONITORING_MODE=local_log
METRICS_LOG_PATH=
ALERT_P95_MS=15000

# 公司批准后填写的公开合规信息；生产环境缺失会 NO-GO
OPERATOR_NAME=
PRIVACY_POLICY_URL=
USER_AGREEMENT_URL=
THIRD_PARTY_LIST_URL=
SUPPORT_CONTACT=
PIPIA_REFERENCE=
AI_SERVICE_DISCLOSURES_JSON=[]
# 投诉/举报正文独立加密密钥（生产环境至少32字符，不与登录密钥复用）
REPORT_DATA_ENCRYPTION_KEY=
REPORT_RETENTION_DAYS=180

# 真实支付：closed_test 不开放收费；live 必须由公司配置商品、商户回调签名和对账
PAYMENT_MODE=closed_test
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PRODUCTS_JSON=[]
PAYMENT_ADAPTER_VERIFIED=false
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300

# 微信 APP 支付：密钥只存服务端，平台公钥文件为 {serial: PEM} JSON；轮换需同时保留新旧 serial 并重启。
# merchant_test 会真实扣款，仅 PAYMENT_TEST_USER_IDS 中账号可下单；不是免费模拟。
# live 仍受账号恢复及支付验收门禁阻断，不能仅改开关上线。
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_FILE=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_KEYS_FILE=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
PAYMENT_TEST_USER_IDS=
PAYMENT_ACCEPTANCE_EVIDENCE=
PAYMENT_RECONCILE_ENABLED=false
PAYMENT_BILL_RECONCILE_ENABLED=false
# App 独立 PostgreSQL 账本：默认 legacy 保留现有闭测数据。不得直接切换含真实订单的旧账本。
BILLING_BACKEND=legacy
BILLING_DATABASE_URL=
# schema 初始化：node scripts/app-billing-migrate.mjs --apply（仅已审查目标库）
# 实例并发、备份恢复、迁移核验的报告及 SHA256 固定值
BILLING_ACCEPTANCE_EVIDENCE=
BILLING_ACCEPTANCE_SHA256=
PAYMENT_ACCEPTANCE_SHA256=
# 手机号绑定/恢复：只接受真实短信回执；无生产万能码。密钥须独立随机生成且 >=32 字符。
ACCOUNT_OTP_SECRET=
ACCOUNT_RECOVERY_VERIFIED=false
SMS_PROVIDER=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_DAILY_LIMIT=200
# 交易存储只支持单主机本地持久卷，禁止 NFS/对象存储/容器临时盘。
COMPLIANCE_SQLITE_FILE=
COMPLIANCE_SQLITE_VOLUME=
COMPLIANCE_SQLITE_EVIDENCE_FILE=
COMPLIANCE_SQLITE_EVIDENCE_SHA256=

# 能力验收证据目录：每个能力一个 JSON 清单，至少 30 个不同 sampleId；缺失即阻断
CAPABILITY_EVIDENCE_DIR=

# 服务
PORT=3000
# Optional bind address; App ECS private testing uses 127.0.0.1.
BIND_HOST=
PUBLIC_BASE_URL=
# 生产出站仅允许已审查的精确供应商/对象存储主机；可用 *.example.com 形式匹配子域
OUTBOUND_HOST_ALLOWLIST=
# 仅非生产本地联调可放行私网主机，生产环境会忽略
OUTBOUND_PRIVATE_HOST_ALLOWLIST=
OUTBOUND_FETCH_TIMEOUT_MS=30000
PROVIDER_FETCH_TIMEOUT_MS=60000
PROVIDER_RESPONSE_MAX_BYTES=2097152
TRUST_PROXY_HEADERS=false
PROVIDER_DAILY_CALL_LIMIT=500
USER_DAILY_GENERATION_LIMIT=30
RATE_LIMIT_MAX_KEYS=10000
# 前端允许的源；Android Capacitor 默认 WebView origin 为 https://localhost
# 示例：CORS_ORIGIN=https://localhost,https://正式H5域名
CORS_ORIGIN=*
# Unified Android accounts: keep disabled until schema migration and acceptance.
APP_LOGIN_ENABLED=false
APP_LOGIN_ACCEPTANCE_EVIDENCE=
APP_LOGIN_ACCEPTANCE_SHA256=
# Use the same approved mobile AppID as the installed Android package.
WECHAT_LOGIN_APPROVED=false
WECHAT_LOGIN_APP_ID=
WECHAT_LOGIN_APP_SECRET=
