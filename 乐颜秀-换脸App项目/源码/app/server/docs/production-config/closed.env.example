# 正式图片服务闭售装配模板；无密钥、不可直接运行。
# 空项由运行环境安全注入；不整份继承 .env.mini-payment 沙箱配置。
# 策略使用 closed-policy-2026-10-12.json；复制后按原始字节核对 SHA256。
RELEASE_CHANNEL=wechat-mini-program
AUTH_MODE=wechat
DEPLOY_ENV=production
XPAY_ENABLED=true
XPAY_ENV=0
XPAY_MODE=closed
WECHAT_APP_ID=REDACTED_APP_IDENTIFIER
WECHAT_APP_SECRET=
# 正式 Key 已由主线核对并安全保存于 .env.mini-production；这里不复制值。
XPAY_APP_KEY=
XPAY_OFFER_ID=
XPAY_SESSION_ENCRYPTION_KEY=
XPAY_MESSAGE_TOKEN=
XPAY_MESSAGE_AES_KEY=

# 正式专用账号已创建、四项库权限及015实际身份连接已核实。
# 私网主机从 mysql-transport.js 的固定目标核对，勿改用公网或沙箱账号。
XPAY_DB_BACKEND=mysql
XPAY_MYSQL_TRANSPORT=cloudrun_builtin_private_production
XPAY_CLOUD_ENV_ID=leyanxiu-prod-d5gimob8af6a6e5c9
XPAY_MYSQL_INSTANCE_ID=cynosdbmysql-7jg96bj6
XPAY_MYSQL_HOST=
XPAY_MYSQL_PORT=3306
XPAY_MYSQL_DATABASE=leyanxiu_xpay_production
XPAY_MYSQL_USER=lyx_xpay_prod
XPAY_MYSQL_PASSWORD=
XPAY_MYSQL_ACCOUNT_HOST=%

# 保留现有大陆北京工作空间的精确 DASHSCOPE_BASE；不要改为任意公共地址。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SECURITY_TOKEN=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE=
OSS_BUCKET=
OSS_REGION=cn-shanghai

# 直挂文件示例；015实际使用已核验的BASE64+SHA装配，不能两种方式同时配置。
PHOTO_PRODUCTION_CONFIG_FILE=/run/leyanxiu-config/photo-policy.json
PHOTO_PRODUCTION_CONFIG_SHA256=00dbed925ad25c1ce0318e135924f847060684392f136b2422efceb8b83c5a17
PHOTO_PRODUCTION_ACCEPTANCE_FILE=/run/leyanxiu-config/photo-generation-v4.json
PHOTO_PRODUCTION_ACCEPTANCE_SHA256=f8cc698254966ab46c22ef60bbfa7c2b47cb82d5705483d45043a9f944a37dde
PHOTO_PRODUCTION_GENERATION_ENABLED=false
PHOTO_PRODUCTION_PROCESS_ENABLED=false
PHOTO_PRODUCTION_CLEANUP_ENABLED=false
XPAY_RECONCILE_ENABLED=false
PHOTO_PRODUCTION_INTERVAL_MS=30000
PHOTO_PRODUCTION_STORAGE_TIMEOUT_MS=4000

# v4 是图片技术证据，不能填入正式支付验收字段。
XPAY_ACCEPTANCE_FILE=
XPAY_ACCEPTANCE_SHA256=
XPAY_PRODUCTS_JSON=[]
XPAY_PURPOSE_RULES_JSON={}
XPAY_TEST_USER_IDS=
XPAY_REFUND_OPERATOR_USER_IDS=

# 只配置实际已发布、无 query/fragment 的规范 HTTPS 公共文档网址。
PRIVACY_POLICY_URL=https://REDACTED_COMPANY_INFRASTRUCTURE/mini/legal/privacy.html
USER_AGREEMENT_URL=https://REDACTED_COMPANY_INFRASTRUCTURE/mini/legal/terms.html
THIRD_PARTY_LIST_URL=https://REDACTED_COMPANY_INFRASTRUCTURE/mini/legal/third-parties.html
AI_SERVICE_DISCLOSURES_JSON=[]
RETENTION_SUPPLIER_POLICY=
PIPIA_REFERENCE=

# 正式 Linux 包的固定运行路径；不在 Windows 上据此声明已验证 Linux。
PORT=3000
BIND_HOST=0.0.0.0
PYTHON_PATH=/usr/bin/python3
AI_MARK_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
DEBUG=
NODE_DEBUG=
NODE_DEBUG_NATIVE=
